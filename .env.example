# Copie para .env.local (fora do git) e preencha as senhas.
# Senha de SYS/SYSTEM/PDBADMIN do Oracle local (só no desktop; na OCI fica vazia).
ORACLE_PWD=
# Local: o serviço "oracle" do compose. OCI: a connect string TLS do ATP (console → Database connection).
ORACLE_DSN=oracle:1521/SENTINELA
ORACLE_USER=SENTINELA
ORACLE_PASSWORD=
# Fuso do dia civil: define o corte de D-1 e das janelas de dias.
FS_ZONE=America/Sao_Paulo
# API: processos do uvicorn e conexões por processo.
API_WORKERS=4
DB_POOL_SIZE=8
# Limites de CPU dos containers (compose).
API_CPUS=8
SIM_CPUS=4
# Onde o simulador encontra a API (dentro da rede do compose).
API_URL=http://api:8000
